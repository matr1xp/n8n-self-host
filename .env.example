# Domain Configuration
DOMAIN_NAME=n8n.ml1.app
SSL_EMAIL=support@ml1.app

# n8n Version (use 'stable' or a specific version tag e.g. '1.70.0')
N8N_VERSION=stable

# n8n Security — generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_USER_MANAGEMENT_JWT_SECRET=

# Task Runner Auth — generate with: openssl rand -hex 32
RUNNERS_AUTH_TOKEN=

# PostgreSQL — root superuser (used only during init)
POSTGRES_USER=n8n_root
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# PostgreSQL — application user (used by n8n at runtime)
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
GENERIC_TIMEZONE=America/New_York
